rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function isValidUserDocument() {
        return request.resource.data.keys().hasOnly(['reminders', 'updatedAt'])
          && request.resource.data.keys().hasAll(['reminders', 'updatedAt'])
          && request.resource.data.reminders is list
          && request.resource.data.reminders.size() <= 500
          && request.resource.data.updatedAt == request.time;
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && isValidUserDocument();
      allow delete: if isOwner();
    }
  }
}
